# =============================================================================
# Secure EHR System (PS02) - Environment configuration
# Copy to .env and adjust. NEVER commit real production values.
# =============================================================================

# --- Application ---
APP_NAME="Secure AI-Powered EHR (PS02)"
ENV=dev                                  # dev | prod
# SQLite for development, PostgreSQL for production:
DATABASE_URL=sqlite:///./ehr.db
# DATABASE_URL=postgresql+psycopg2://ehr:ehr_secret@localhost:5432/secure_ehr

# --- Cryptography -------------------------------------------------------------
# Master key (base64, 32 bytes). If unset, a dev key is auto-generated and
# persisted to SECRETS_DIR/master.key (chmod 600). ALL derived keys
# (AES data keys, audit HMAC key, JWT signing key, ABE wrap key) come from
# this single root via HKDF-SHA256.
# Generate one with:  python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
MASTER_KEY_B64=
SECRETS_DIR=./.secrets

# --- JWT / auth ---
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7

# --- API hardening ---
RATE_LIMIT_RPS=20
RATE_LIMIT_BURST=40
TRUSTED_HOSTS=localhost,127.0.0.1
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- AI stack ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# --- ML artifacts directory (XGBoost .json models + conformal calibration) ---
MODELS_DIR=./models
